SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# DB_ENGINE=sqlite uses db.sqlite3 in the project folder; unset (or anything else) uses MySQL below
# DB_ENGINE=sqlite
DB_NAME=clinic_saas_db
DB_USER=root
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Email: without EMAIL_BACKEND, emails are printed to the runserver console.
# For Gmail, use smtp and a Google App Password (not your normal password).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password

# Public address of the site, used to build the links in emails (no trailing slash).
# Locally the default is http://127.0.0.1:8000; on the server e.g.:
# SITE_URL=https://aboshwiki.pythonanywhere.com

# Production only (read when DEBUG=False):
# SECURE_SSL_REDIRECT=False    # PythonAnywhere: use "Force HTTPS" in the Web tab instead
# SECURE_COOKIES=True          # cookies only over HTTPS
# SECURE_HSTS_SECONDS=0        # raise to 31536000 once HTTPS is confirmed working
